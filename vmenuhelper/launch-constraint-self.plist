<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Launch Constraint (Self) for vmenu helper

  This constraint requires that the helper binary itself is signed by the
  vmenu team (ZY2BN8SN9F). This validates the helper's own code signature
  at launch time.

  On macOS 26 (Tahoe), Developer ID signed binaries with launch constraints
  must have valid self-constraints that can be evaluated against the binary
  being launched.

  Note: validation-category applies to the PARENT process, not self.
  For self constraints, use team-identifier to verify the binary's signature.
-->
<plist version="1.0">
<dict>
    <key>team-identifier</key>
    <string>ZY2BN8SN9F</string>
</dict>
</plist>
